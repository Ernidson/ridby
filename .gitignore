viewer_cache/
viewer_cache/**/*

# Rigby2D specific
rigby2d/dist/
rigby2d/build/
rigby2d/node_modules/
rigby2d/src-tauri/target/
rigby2d/src-tauri/gen/schemas/
# Large binary files in rigby2d (including versioned names like .so.1, .dylib.1.30.0, etc.)
rigby2d/*.so*
rigby2d/*.dylib*
rigby2d/*.dll*
rigby2d/*.wasm*
rigby2d/*.node*
rigby2d/**/*.so*
rigby2d/**/*.dylib*
rigby2d/**/*.dll*
rigby2d/**/*.wasm*
rigby2d/**/*.node*

