*.7z

# Explicitly allow only specific important files at root
!AGENTS.md
!LEIA-ME.md
!*.md
!package.json
!package-lock.json
!tsconfig.json
!*.js
!*.mjs
!*.ts
!*.html
!*.css
!*.yaml
!*.yml
!*.toml
!*.cfg
!*.ini
!*.gitignore
!LICENSE
!README*
!CHANGELOG*
!CONTRIBUTING*
# Allow JSON only in specific directories (not in projetos/)
!rigby2d/**/*.json
!viewer/**/*.json