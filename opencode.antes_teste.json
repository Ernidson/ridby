{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "execute",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "mcp": {
    "servers": {
      "rigby2d": {
        "type": "local",
        "command": [
          "node",
          "D:\\Projetos\\RIGBY2D_ESTUDIO\\rigby2d\\src\\mcp\\server.js",
          "--root",
          "D:\\Projetos\\RIGBY2D_ESTUDIO\\projetos"
        ],
        "codemode": false
      }
    }
  }
}